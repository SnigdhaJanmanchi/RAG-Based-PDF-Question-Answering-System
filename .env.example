# Copy to .env and fill in values. Never commit .env.
# Docker Compose reads this file for provider settings and other overrides.

# --- LLM provider (env switch only; never falls back between providers) ---
# Local free default: ollama. Set openai + OPENAI_API_KEY for paid OpenAI.
LLM_PROVIDER=ollama

# OpenAI (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Ollama (default provider). Must stay on localhost — do not expose publicly.
# Ollama itself is free per-request; Cursor cloud / VM compute may still cost.
# Cloud agent disks are ephemeral — re-pull models after new VMs / rebuilds.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_PREDICT=512

# Sentence Transformers embedding model (baked into API image by default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.25
CONTEXT_TOKEN_BUDGET=2500

# Runtime data directory (local venv runs). In Compose this is /app/data on a volume.
DATA_DIR=data
MAX_UPLOAD_BYTES=10485760

# API
APP_NAME=AI PDF Assistant
APP_ENV=development
LOG_LEVEL=INFO
# Browser→API CORS (Swagger). Streamlit calls the API server-side (no browser CORS).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Local Streamlit (venv). Compose overrides UI to http://api:8000.
API_BASE_URL=http://localhost:8000

# --- Docker Compose optional overrides ---
API_PORT=8000
UI_PORT=8501
# Soft resource caps (raise on larger hosts; API needs RAM for torch + MiniLM + optional Ollama host)
API_MEM_LIMIT=4g
API_CPUS=2.0
UI_MEM_LIMIT=1g
UI_CPUS=0.5
# Keep 1 unless you intentionally refresh embedding weights from Hugging Face
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
