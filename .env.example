# Copy to .env and fill in values. Never commit .env.

# Required for Phase 3 (POST /ask). Leave empty to use upload/search only.
OPENAI_API_KEY=

# Cost-effective chat model (Phase 3)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Sentence Transformers embedding model (Phase 2+)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking (Phase 2+)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval (Phase 2–3)
TOP_K=5
# Minimum cosine similarity (FAISS IP on L2-normalized vectors) to keep a chunk
SIMILARITY_THRESHOLD=0.25
# Approx token budget for retrieved context passed to the LLM
CONTEXT_TOKEN_BUDGET=2500

# Runtime data directory (uploads, FAISS index, metadata) — gitignored
DATA_DIR=data

# Max PDF upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760

# API
APP_NAME=AI PDF Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit UI (Phase 4) — points at the FastAPI server
API_BASE_URL=http://localhost:8000
