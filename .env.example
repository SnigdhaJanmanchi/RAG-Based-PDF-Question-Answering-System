# Copy to .env and fill in values. Never commit .env.

# Required for Phase 3+ (RAG answer generation). Not used in Phase 2.
OPENAI_API_KEY=

# OpenAI chat model (Phase 3+)
OPENAI_MODEL=gpt-4o-mini

# Sentence Transformers embedding model (Phase 2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking (Phase 2)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval top-k (Phase 2+)
TOP_K=5

# Runtime data directory (uploads, FAISS index, metadata) — gitignored
DATA_DIR=data

# Max PDF upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760

# API
APP_NAME=AI PDF Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
